[Unit]
Description=Incident Lab (cs-study) static web prototype
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/orca/cs-study
Environment=HOST=<TAILSCALE_IP>
Environment=PORT=8790
ExecStart=/usr/bin/env node server/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
